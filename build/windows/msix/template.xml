<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="flowlens"
        Arguments=""
        InstallLocation="C:\Program Files\观流">
    </Installer>
    <PackageInformation
        PackageName="观流"
        PackageDisplayName="观流"
        PublisherName="CN=Kerison"
        PublisherDisplayName="观流"
        Version="0.2.0.0"
        PackageDescription="观流 - 跨平台 HTTP/HTTPS 抓包工作台">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.kerison.flowlens"
                Description="观流 - 跨平台 HTTP/HTTPS 抓包工作台"
                DisplayName="观流"
                ExecutableName="flowlens"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>观流</DisplayName>
            <PublisherDisplayName>Kerison</PublisherDisplayName>
            <Description>Cross-platform HTTP/HTTPS traffic inspector</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="flowlens.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
